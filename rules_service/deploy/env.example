# /etc/mtg-engine/env  (root:mtgengine, mode 640). No secrets in here today.
MTG_ENV=production
MTG_RULES_PORT=8791
MTG_LOG_LEVEL=INFO
# The nightly jobs that write these don't exist yet. Uncomment MTG_FACTS_FILE when that job does.
# MTG_FACTS_FILE=/var/lib/mtg-engine/facts.json
MTG_SCAN_FILE=/var/lib/mtg-engine/scan_latest.json
# NEVER set MTG_RULES_TEST_FACTS on this server (the service refuses to start if you do).
